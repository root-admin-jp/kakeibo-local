# このファイルを .env にコピーして、値を書き換えて使う（.env はコミットしない）。
# パスワード類は推測されにくい長い文字列にすること。

# MySQL の root パスワード
MYSQL_ROOT_PASSWORD=change-me-root
# アプリ用 DB ユーザーのパスワード（db と api で共用）
DB_PASSWORD=change-me-db

# JWT の署名キー（長いランダム文字列。変えると既存ログインは無効になる）
JWT_SECRET=change-me-to-a-long-random-string

# 使うイメージのタグ（リリースタグか latest）
KAKEIBO_VERSION=latest

# メール OTP の送信設定（v0.4.0 以降）
# 既定の log のままだと、ログインコードは API コンテナのログに出力される
# （docker compose logs api で確認できる。手元で試す分にはこれで足りる）
# 実際にメールを送る場合は smtp にして、SMTP サーバーの設定を埋める
# MAIL_MODE=smtp
# MAIL_FROM=noreply@example.com
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true

# パスキー (WebAuthn) の設定（v0.4.0 以降）
# localhost で使う分には既定のままでよい。それ以外のホスト名で使う場合は
# HTTPS 化したうえで、自分のドメインに合わせて変更する
# WEBAUTHN_RP_ID=example.com
# WEBAUTHN_RP_NAME=Kakeibo
# WEBAUTHN_ORIGINS=https://example.com
# 任意: ポートを変えたい場合
# WEB_PORT=3000
# API_PORT=8080
# NUXT_PUBLIC_API_BASE=http://localhost:8080
