# このファイルを .env にコピーして、値を書き換えて使う（.env はコミットしない）。
# パスワード類は推測されにくい長い文字列にすること。

# MySQL の root パスワード
MYSQL_ROOT_PASSWORD=change-me-root
# アプリ用 DB ユーザーのパスワード（db と api で共用）
DB_PASSWORD=change-me-db

# JWT の署名キー（長いランダム文字列。変えると既存ログインは無効になる）
JWT_SECRET=change-me-to-a-long-random-string

# 使うイメージのタグ（リリースタグか latest）
KAKEIBO_VERSION=latest
# 任意: ポートを変えたい場合
# WEB_PORT=3000
# API_PORT=8080
# NUXT_PUBLIC_API_BASE=http://localhost:8080
